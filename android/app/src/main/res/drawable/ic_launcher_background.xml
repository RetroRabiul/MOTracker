<?xml version="1.0" encoding="utf-8"?>
<!--
  MOTracker launcher background.

  The brand primary is #8b5cf6 (the Amethyst palette). This was #2563eb, a blue
  that appears nowhere in the running app, so the icon was advertising a colour
  the product had moved on from. A gradient is used rather than a flat fill
  because adaptive icons are masked by the launcher and a flat field reads as an
  empty square at small sizes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#6d28d9"
        android:centerColor="#7c3aed"
        android:endColor="#a78bfa" />
</shape>
