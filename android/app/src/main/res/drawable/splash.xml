<?xml version="1.0" encoding="utf-8"?>
<!--
  MOTracker splash.

  This replaces twelve pre-rendered splash.png files (one per density and
  orientation). They were a flat #2563eb field with no mark, so the launch
  screen showed a blue rectangle that matched neither the app's brand nor its
  icon, and every density had to be regenerated by hand after a colour change.

  A layer-list is resolution independent, so one file covers every screen and
  the gradient cannot drift out of sync with the launcher icon.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#4c1d95"
                android:centerColor="#6d28d9"
                android:endColor="#8b5cf6" />
        </shape>
    </item>

    <!-- Same vector the launcher icon uses, centred. Held to 132dp so it sits
         comfortably inside the safe area on short landscape screens. -->
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="132dp"
        android:height="132dp" />

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
